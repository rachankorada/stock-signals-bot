# Copy to .env and fill in. Never commit .env.
ALPACA_API_KEY=your-paper-key
ALPACA_SECRET_KEY=your-paper-secret

# Bar history, models and the database. Keep this outside OneDrive.
DATA_DIR=C:/Users/you/StockAnalyzerData

# Also send top-confidence setups from models that failed validation (labelled "Unvalidated")
ALLOW_UNVALIDATED=false

# Mirror every signal as a bracket order in the Alpaca paper account
PAPER_TRADE=false
PAPER_RISK_DOLLARS=50

# Contact address sent to browser push services, e.g. mailto:you@yourdomain.com
VAPID_CONTACT=mailto:admin@example.com
